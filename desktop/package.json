{
  "name": "agent-desk-desktop",
  "productName": "Agent Desk",
  "private": true,
  "description": "Local desktop workspace for coding agents",
  "author": "Agent Desk contributors",
  "license": "Apache-2.0",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron-forge start",
    "test": "node --test test/*.test.cjs",
    "stage": "node scripts/stage-runtime.cjs",
    "package": "npm run stage && electron-forge package --platform=darwin --arch=arm64",
    "make": "npm run stage && electron-forge make --platform=darwin --arch=arm64 && node scripts/make-dmg.cjs",
    "test:smoke": "node test/smoke.cjs",
    "test:packaged": "node test/packaged.cjs",
    "test:dmg": "node test/dmg.cjs",
    "test:startup": "node test/startup.cjs",
    "test:about": "node test/about.cjs",
    "branding": "node scripts/branding.cjs",
    "test:transport": "node test/transport.cjs",
    "test:quit-preparation": "node test/quit-preparation.cjs",
    "test:backend-lifecycle": "node test/backend-lifecycle.cjs",
    "test:webhooks": "node test/webhooks.cjs",
    "test:quit": "node test/quit.cjs",
    "test:development-workflow": "node test/development-workflow.cjs"
  },
  "dependencies": {
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@electron-forge/plugin-base": "8.0.1",
    "@electron-forge/plugin-fuses": "8.0.1",
    "@electron/fuses": "2.1.3",
    "@electron/osx-sign": "2.7.1",
    "electron": "45.0.0"
  },
  "config": {
    "forge": "./forge.config.cjs"
  }
}
